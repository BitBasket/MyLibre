{
    "name": "mylibre/glucose-dashboard",
    "description": "Local-first LibreLinkUp glucose dashboard for Linux",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": "^8.4",
        "ext-json": "*",
        "phpexperts/simple-dto": "^3.9",
        "phpexperts/rest-speaker": "^3.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.5"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "App\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "init-pgp": "php bin/init-pgp.php",
        "migrate-sqlite": "php bin/migrate-sqlite.php",
        "poll": "php bin/poll-glucose.php",
        "serve": "php -S 127.0.0.1:8765 -t public public/router.php"
    },
    "config": {
        "sort-packages": true
    }
}
